// By default the database already has inside the countries SG, TH, ID, PH, MY, VN
model Country{
    id String @id @default(cuid())
    name String
    countryCode String @unique //Put ISO 3166-1 alpha-2 code of the country
    phone String
    active Boolean @default(true)
    consultants Consultant[]
    users User[] @relation("UserCountriesHandled")
    contracts Contract[]
    performanceReviews PerformanceReview[]
}

model Languages{
    id String @id @default(cuid())
    name String
    consultants ConsultantLanguage[]
    active Boolean @default(true)
}

model Industries{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}

model Skills{
    id String @id @default(cuid())
    name String
    consultants ConsultantSkill[]
    active Boolean @default(true)
}

model Jobs{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}

model Document {
    id String @id @default(cuid())
    fileName String @unique               // file name in the google drive directory
    displayFileName String                // file name displayed in the UI and when downloading
    fileExtension String                  // pdf/docx/pdf whatever
    mimeType String
    driveFileId String @unique
    driveFolderId String?

    consultantId String?
    consultant Consultant? @relation(fields: [consultantId], references: [id])

    contractId String?
    contract Contract? @relation(fields: [contractId], references: [id])
    dateCreate DateTime @default(now())
}