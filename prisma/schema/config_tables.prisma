// By default the database already has inside the countries SG, TH, ID, PH, MY, VN
model Country{
    id String @id @default(cuid())
    name String
    countryCode String @unique //Put ISO 3166-1 alpha-2 code of the country
    phone String
    cities City[]
    active Boolean @default(true)
    users User[] @relation("UserCountriesHandled")
}

model City{
    id String @id @default(cuid())
    name String
    countryId String
    country Country @relation(fields: [countryId], references: [id])
    active Boolean @default(true)
}

model Languages{
    id String @id @default(cuid())
    name String
    active Boolean @default(true)
}

model Skills{
    id String @id @default(cuid())
    name String
    active Boolean @default(true)
}