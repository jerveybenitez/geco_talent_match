// By default the database already has inside the countries SG, TH, ID, PH, MY, VN
model Country{
    id String @id @default(cuid())
    name String
    countryCode String @unique //Put ISO 3166-1 alpha-2 code of the country
    phone String
    active Boolean @default(true)
    consultants Consultant[]
    users User[] @relation("UserCountriesHandled")
}

model Languages{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}

model Industries{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}

model Skills{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}

model Jobs{
    id String @id @default(cuid())
    name String
    consultants Consultant[]
    active Boolean @default(true)
}