enum Role {
    superadmin
    admin
    user
}

enum ConsultantStatus {
    Available
    Committed
    Former
}

enum FluencyLevel {
  basic
  conversational
  fluent
  native
}

model User {
  id String @id @default(cuid())
  email String @unique
  hashedPassword String
  name String
  image String?
  dateCreate DateTime @default(now())
  phone String?
  countriesHandled Country[] @relation("UserCountriesHandled")
  consultant Consultant?
  role Role @default(user)
  sessions Session[]
  active Boolean @default(true)
  performanceReviewsCreated PerformanceReview[] @relation("PerformanceReviewCreatedBy")
  performanceReviewsSent PerformanceReview[] @relation("PerformanceReviewSentBy")
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Consultant {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  status ConsultantStatus @default(Available)
  skills ConsultantSkill[]
  languages ConsultantLanguage[] 
  industries Industries[]
  linkedin String?
  professionalBio String?
  yearsOfExperience Float?
  city String
  country Country @relation(fields: [countryId], references: [id])
  countryId String
  job Jobs @relation(fields: [jobId], references: [id])
  jobId String
  availableFrom DateTime
  availableTo DateTime
  active Boolean @default(true)
  dateCreate DateTime @default(now())
  contracts Contract[]
  workHistory WorkHistory[]
  performanceReviews PerformanceReview[]
  documents Document[]
}

model ConsultantLanguage {
  id String @id @default(cuid())
  consultant Consultant @relation(fields: [consultantId], references: [id])
  consultantId String
  language Languages @relation(fields: [languageId], references: [id])
  languageId String
  fluency FluencyLevel
  @@unique([consultantId, languageId])
}

model ConsultantSkill {
  id String @id @default(cuid())
  consultant Consultant @relation(fields: [consultantId], references: [id])
  consultantId String
  skill Skills @relation(fields: [skillId], references: [id])
  skillId String
  @@unique([consultantId, skillId])
}

model WorkHistory {
  id String @id @default(cuid())
  consultantId String
  consultant Consultant @relation(fields: [consultantId], references: [id])
  companyName String
  position String
  description String?
  startDate DateTime
  endDate DateTime?
  isCurrent Boolean @default(false)
  active Boolean @default(true)
}