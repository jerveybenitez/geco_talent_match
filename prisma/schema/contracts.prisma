enum ContractAllowanceFrequency {
  monthly
  quarterly
  yearly
}

model Client {
    id String @id @default(cuid())
    name String
    contracts Contract[]
    active Boolean @default(true)
    dateCreate DateTime @default(now())
    performanceReviews PerformanceReview[]
}

model ContractType {
    id String @id @default(cuid())
    name String @unique
    contracts Contract[]
    description String?
    active Boolean @default(true)
}

model ContractAllowance {
    id String @id @default(cuid())
    name String
    amountUsd Float
    frequency ContractAllowanceFrequency @default(monthly)
    contract Contract @relation(fields: [contractId], references: [id])
    contractId String
    active Boolean @default(true)
    dateCreate DateTime @default(now())
}

model Contract {
  id String @id @default(cuid())
  name String
  city String
  country Country @relation(fields: [countryId], references: [id])
  countryId String
  consultant Consultant @relation(fields: [consultantId], references: [id])
  consultantId String
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  monthlySalary Float
  contractType ContractType @relation(fields: [contractTypeId], references: [id])
  contractTypeId String
  gecoJoinDate DateTime
  deploymentDate DateTime
  renewalDate DateTime?
  contractstartDate DateTime
  contractendDate DateTime
  deploymentNote String?
  allowances ContractAllowance[]
  documents Document[]
  dateCreate DateTime @default(now())
  active Boolean @default(true)
}

