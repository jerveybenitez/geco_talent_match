enum ReviewType {
  quarterly
  semiannual
  annual
  monthly
  probation
}

enum ReviewStatus {
  inprogress
  draft
  completed
  overdue
}

enum ReviewSendStatus{
  unsent
  sent
  sendfailed
}

enum ClientReviewStatus {
  pending
  replied
}

enum ConsultantReviewStatus {
  pending
  replied
}

model PerformanceReview {
  id String @id @default(cuid())
  reviewType ReviewType
  reviewStatus ReviewStatus @default(inprogress)
  clientStatus ClientReviewStatus @default(pending)
  consultantStatus ConsultantReviewStatus @default(pending)
  consultant Consultant @relation(fields: [consultantId], references: [id])
  consultantId String
  client Client @relation(fields: [clientId], references: [id])
  clientId String
  country Country @relation(fields: [countryId], references: [id])
  countryId String
  dueDate DateTime
  clientEmail String
  linkGenerate String?
  dateCreate DateTime @default(now())
  active Boolean @default(true)

  /* All ratings will be 0-5 */
  clientRating Float?
  clientCompetencyRating Float?
  clientCommunicationRating Float?
  clientProblemSolvingRating Float?
  clientKeyStrengths String?
  clientAreasForImprovement String?
  clientProjectFeedback String?

  consultantSelfRating Float?
  consultantSkillDevelopmentRating Float?
  consultantTeamworkRating Float?
  consultantGoalAchievementRating Float?
  consultantKeyAchievements String?
  consultantChallengesFaced String?
  consultantFutureGoals String?

  reviewSentStatus ReviewSendStatus @default(unsent)
  failSendReason String?
  createdBy User? @relation("PerformanceReviewCreatedBy", fields: [createdById], references: [id])
  createdById String?
  sentBy User? @relation("PerformanceReviewSentBy", fields: [sentById], references: [id])
  sentById String?
}

